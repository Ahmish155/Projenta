PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/workspace-saas
CLIENT_URL=http://localhost:5173

# Firebase Admin SDK — used to verify sign-ins and to let admins create
# teammate accounts with a password directly from the Users page.
#
# Option A (simplest for local dev): download your service account key from
# Firebase Console > Project Settings > Service accounts > Generate new private key,
# save it as backend/serviceAccountKey.json (already gitignored) — no env var needed.
#
# Option B (recommended for hosting e.g. Render/Railway): paste the ENTIRE
# downloaded JSON here as a single line.
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"...", ...}
